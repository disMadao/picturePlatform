# 复制为 .env（放在 agent-backend 目录）并按你的服务器环境填写，然后：
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Java 后端（你的 picture-backend 的地址）
# 如果你的 Java 后端不在同一个 docker compose 里：
# - 推荐填宿主机内网地址（如 172.17.0.1 / 服务器内网 IP）或域名（走 nginx）
# - 或继续使用 host.docker.internal（docker-compose.prod.yml 已加 extra_hosts 兼容 Linux）
JAVA_BASE_URL=http://118.195.165.9:8123/api

# Milvus（容器内一般不需要改）
MILVUS_URI=http://standalone:19530

# DeepSeek（可选）
DEEPSEEK_API_KEY=sk-b3c2675a9c5e4297b404db9b82623594
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL（用于写 agent_session/agent_message；如果不需要记录，可不填但会报错后被 try/except 吞掉）
